           <spacer name="verticalSpacer_ai_ui">
            <property name="orientation">
             <enum>Qt::Vertical</enum>
            </property>
            <property name="sizeHint" stdset="0">
             <size>
              <width>20</width>
              <height>40</height>
             </size>
            </property>
           </spacer>
          </item>
         </layout>
        </widget>

        <!-- Page 3: Plugins Manager -->
        <widget class="QWidget" name="page_plugins">
         <layout class="QHBoxLayout" name="horizontalLayout_plugins">
          <item>
           <widget class="QListWidget" name="pluginListWidget">
            <property name="maximumSize">
             <size>
              <width>220</width>
              <height>16777215</height>
             </size>
            </property>
           </widget>
          </item>
          <item>
           <layout class="QVBoxLayout" name="verticalLayout_plugins_right">
            <item>
             <widget class="QCheckBox" name="pluginEnabledCheckBox">
              <property name="enabled">
               <bool>false</bool>
              </property>
              <property name="text">
               <string>Enable Plugin in NST System</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QGroupBox" name="pluginInfoGroupBox">
              <property name="title">
               <string>Plugin Information &amp; Metadata</string>
              </property>
              <layout class="QVBoxLayout" name="verticalLayout_plugin_info">
               <item>
                <widget class="QLabel" name="pluginInfoLabel">
                 <property name="text">
                  <string>Select a plugin from the list to view metadata and status.</string>
                 </property>
                 <property name="wordWrap">
                  <bool>true</bool>
                 </property>
                 <property name="alignment">
                  <set>Qt::AlignTop|Qt::AlignLeft</set>
                 </property>
                </widget>
               </item>
              </layout>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="reloadPluginsButton">
              <property name="text">
               <string>Reload Plugins List</string>
              </property>
             </widget>
            </item>
            <item>
             <spacer name="verticalSpacer_plugins">
              <property name="orientation">
               <enum>Qt::Vertical</enum>
              </property>
             </spacer>
            </item>
           </layout>
          </item>
         </layout>
        </widget>

       </widget>
      </item>
      <item>
       <widget class="QDialogButtonBox" name="buttonBox">
        <property name="standardButtons">
         <set>QDialogButtonBox::Cancel|QDialogButtonBox::Ok</set>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections>
  <connection>
   <sender>buttonBox</sender>
   <signal>accepted()</signal>
   <receiver>SettingsDialog</receiver>
   <slot>accept()</slot>
  </connection>
  <connection>
   <sender>buttonBox</sender>
   <signal>rejected()</signal>
   <receiver>SettingsDialog</receiver>
   <slot>reject()</slot>
  </connection>
  <connection>
   <sender>settingsListWidget</sender>
   <signal>currentRowChanged(int)</signal>
   <receiver>configStackedWidget</receiver>
   <slot>setCurrentIndex(int)</slot>
  </connection>
 </connections>
</ui>
