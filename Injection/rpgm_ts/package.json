{
  "name": "nst-translator",
  "version": "1.0.0",
  "description": "NST Translation Layer — runtime translation plugin for RPG Maker MV/MZ games. TypeScript source that builds to a single drop-in JS file.",
  "license": "GPL-3.0",
  "type": "module",
  "main": "dist/NST_TranslationLayer.js",
  "scripts": {
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && rollup -c",
    "build:prod": "npm run clean && rollup -c --environment NODE_ENV:production"
  },
  "keywords": [
    "rpg-maker",
    "rpgm",
    "mv",
    "mz",
    "translation",
    "localization",
    "nst",
    "i18n"
  ],
  "author": "NST",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@rollup/plugin-babel": "^7.0.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^25.6.0",
    "ahocorasick": "^1.0.2",
    "core-js": "^3.49.0",
    "mnemonist": "^0.40.3",
    "rimraf": "^6.1.3",
    "rollup": "^4.60.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {}
}
